{
  "manifest_version": 3,
  "name": "ChromaSense — Color Vision Adapter",
  "version": "1.0.0",
  "description": "Real-time color adaptation for CVD users. Links with the ChromaSense web app.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png" },
    "default_title": "ChromaSense"
  },
  "permissions": ["storage","tabs","activeTab","scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": { "service_worker": "background.js" },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}